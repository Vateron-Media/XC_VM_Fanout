{
  "etag": "abc123",
  "ver": 1,
  "data": {
    "runtime": {
      "kind": "transcode",
      "spec": {
        "sources": [
          {"label": "src0", "cmd": "{ffmpeg_cpu} -i http://a/1 -c:v libx264 -f tee 'unix:{ingest_sock}' {streams}7_.m3u8"}
        ],
        "policy": {"on_demand": true, "stop_failures": 0},
        "health": {},
        "pid_path": "{streams}7_.pid",
        "errors_path": "{streams}7.errors",
        "log_path": "{logs}stream_log.log",
        "server_id": "{server_id}",
        "adopt_match": "{streams}7_.m3u8",
        "encrypt": true
      }
    }
  }
}
